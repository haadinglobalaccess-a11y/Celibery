{
  "name": "celibery-international",
  "version": "1.0.0",
  "private": true,
  "description": "CELIBERY International — bilingual (Arabic/English) e-commerce platform for Saudi Arabia: storefront, admin dashboard and API.",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "build:vercel": "npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client && tsc -p api/tsconfig.json --noEmit",
    "test": "npm run test -w server",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "start": "npm run start -w server",
    "seed:base": "npm run seed:base -w server",
    "seed:demo": "npm run seed:demo -w server",
    "create-staff": "npm run create-staff -w server --",
    "import:products": "npm run import:products -w server --",
    "migrate": "npm run migrate -w server --",
    "test:unit": "npm run test:unit -w server"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0"
  }
}
