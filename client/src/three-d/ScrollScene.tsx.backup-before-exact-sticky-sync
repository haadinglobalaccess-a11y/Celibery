import { useEffect, useRef, type CSSProperties, type ElementType, type ReactNode, type RefObject } from 'react';
import { reducedMotion } from './env';

/**
 * One shared, passive, rAF-throttled scroll loop for every scroll-linked scene on the page.
 * Each registered element only updates while it is on screen (IntersectionObserver gate).
 */
type Entry = { el: HTMLElement; cb: (p: number, el: HTMLElement) => void; on: boolean };
const entries = new Set<Entry>();
let frame = 0;
let bound = false;
const tick = () => {
  frame = 0;
  const vh = window.innerHeight;
  for (const e of entries) {
    if (!e.on) continue;
    const r = e.el.getBoundingClientRect();
    // 0 when the element's top enters the bottom of the viewport, 1 when its bottom leaves the top
    const p = Math.max(0, Math.min(1, (vh - r.top) / (vh + r.height)));
    e.cb(p, e.el);
  }
};
const schedule = () => {
  if (!frame) frame = requestAnimationFrame(tick);
};
const io = typeof IntersectionObserver !== 'undefined'
  ? new IntersectionObserver((list) => {
      for (const it of list) for (const e of entries) if (e.el === it.target) e.on = it.isIntersecting;
      schedule();
    }, { rootMargin: '10% 0px' })
  : null;

/** Calls `cb(progress 0..1)` as the element moves through the viewport. */
export function useScrollProgress<T extends HTMLElement>(ref: RefObject<T>, cb: (p: number, el: T) => void) {
  const cbRef = useRef(cb);
  cbRef.current = cb;
  useEffect(() => {
    const el = ref.current;
    if (!el || !io || reducedMotion()) return;
    const entry: Entry = { el, cb: (p, e) => cbRef.current(p, e as T), on: false };
    entries.add(entry);
    io.observe(el);
    if (!bound) {
      bound = true;
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
    }
    schedule();
    return () => {
      entries.delete(entry);
      io.unobserve(el);
    };
  }, [ref]);
}

/**
 * Section wrapper exposing its scroll progress as `--p` (0..1) and `--pc` (-1..1, centred).
 * Layers inside use calc() with these variables for depth-based parallax (see .scene-* in CSS).
 * Without JS-driven motion (reduced motion) the variables stay at their resting values.
 */
export function ScrollScene({ children, className = '', as: Tag = 'div', id, style }: { children: ReactNode; className?: string; as?: ElementType; id?: string; style?: CSSProperties }) {
  const ref = useRef<HTMLElement | null>(null);
  useScrollProgress(ref, (p, el) => {
    el.style.setProperty('--p', p.toFixed(4));
    el.style.setProperty('--pc', (p * 2 - 1).toFixed(4));
    if (el.id === 'story') {
      const storyProgress = Math.max(0, Math.min(1, (p - 1 / 221) / (219 / 221)));
      const word = el.querySelector<HTMLElement>('.story-scene__word');
      if (word) {
        const distance = (0.5 - storyProgress) * (window.innerWidth + word.offsetWidth);
        word.style.setProperty('--story-x', `${distance.toFixed(2)}px`);
      }
    }
  });
  return (
    <Tag ref={ref} id={id} className={`scene ${className}`} style={{ '--p': 0.5, '--pc': 0, ...style } as CSSProperties}>
      {children}
    </Tag>
  );
}
