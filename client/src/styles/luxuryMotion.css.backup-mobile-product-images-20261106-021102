/* Finishing layer: reuse existing tilt inputs, reveal states and image frames. */
:root {
  --luxury-ease: cubic-bezier(.22, .75, .25, 1);
  --luxury-return: cubic-bezier(.2, .85, .25, 1.04);
  --luxury-sweep-ease: cubic-bezier(.45, 0, .25, 1);
  --ease-out-expo: cubic-bezier(.16, 1, .3, 1);
  --ease-cinema: var(--luxury-ease);
}

/* Glass remains a surface treatment; menus keep their existing stacking and hit targets. */
.header {
  background: rgb(255 255 255 / .84);
  border-bottom-color: rgb(228 228 231 / .65);
  box-shadow: inset 0 1px 0 rgb(255 255 255 / .9), 0 4px 24px -20px rgb(17 17 17 / .2);
  transition: background 500ms var(--luxury-ease), border-color 500ms var(--luxury-ease), box-shadow 600ms var(--luxury-ease);
}
@supports (backdrop-filter: blur(1px)) {
  .header { background: rgb(255 255 255 / .96); backdrop-filter: blur(8px) saturate(110%); }
  .header.is-scrolled { background: rgb(255 255 255 / .62); backdrop-filter: blur(22px) saturate(135%); }
}
.header.is-scrolled {
  border-bottom-color: rgb(228 228 231 / .85);
  box-shadow: inset 0 1px 0 rgb(255 255 255 / .95), 0 14px 36px -26px rgb(17 17 17 / .32);
}

/* Narrow champagne reflection: never a tint over the whole product. */
.card--3d .card__shine {
  z-index: 2;
  background: linear-gradient(112deg, transparent 32%, rgb(226 204 167 / .18) 42%, rgb(255 250 237 / .78) 50%, rgb(239 223 195 / .26) 57%, transparent 68%);
  mix-blend-mode: normal;
  transform: translateX(-125%);
  pointer-events: none;
}
.product-motion__card--visible.card--3d .card__shine { animation: luxury-sweep-entry 2200ms var(--luxury-sweep-ease) calc(var(--product-delay, 100ms) + 350ms) both; }
.card--3d .tilt__glare {
  background: radial-gradient(ellipse at var(--gx, 50%) var(--gy, 50%), rgb(255 247 231 / .28), transparent 62%);
  opacity: calc(var(--tz, 0) * .5);
}

.card--3d { perspective: none; transform-style: flat; }
.card--3d .card__media {
  transform: perspective(1100px) rotateX(var(--rx)) rotateY(var(--ry)) translateZ(calc(var(--tz) * 14px));
  transition: transform 850ms var(--luxury-return), box-shadow 750ms var(--luxury-ease);
  box-shadow: inset 0 1px 0 rgb(255 255 255 / .78), 0 2px 5px -3px rgb(17 17 17 / .12), 0 14px 32px -24px rgb(17 17 17 / .24);
}
.card--3d.is-tilting .card__media {
  transition: transform 180ms var(--luxury-ease), box-shadow 600ms var(--luxury-ease);
}
.card--3d .card__media img {
  translate: calc(var(--px) * -3px) calc(var(--py) * -3px);
}
.dark .card--3d .card__media {
  box-shadow: inset 0 1px 0 rgb(255 255 255 / .12), 0 4px 12px -6px rgb(0 0 0 / .3), 0 20px 40px -26px rgb(0 0 0 / .6);
}
@media (hover: hover) and (pointer: fine) {
  .card--3d:hover .card__media {
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .86), 0 4px 8px -5px rgb(17 17 17 / .15), 0 28px 48px -30px rgb(17 17 17 / .36);
  }
  .product-motion__card--visible.card--3d:hover .card__shine { animation: luxury-sweep-hover 2200ms var(--luxury-sweep-ease) both; }
  .product-story__slide[data-active='true'] .product-story__image:hover::after,
  .auto-showcase__slide.is-in-view .auto-showcase__image:hover::after { animation: luxury-sweep-hover 2200ms var(--luxury-sweep-ease) both; }
}
.product-story__image, .auto-showcase__image { overflow: hidden; }
.product-story__image::after, .auto-showcase__image::after {
  content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 1;
  background: linear-gradient(112deg, transparent 32%, rgb(226 204 167 / .15) 42%, rgb(255 250 237 / .65) 50%, rgb(239 223 195 / .22) 57%, transparent 68%);
  transform: translateX(-125%);
}
.product-story__slide[data-active='true'] .product-story__image::after,
.auto-showcase__slide.is-in-view .auto-showcase__image::after { animation: luxury-sweep-entry 2200ms var(--luxury-sweep-ease) 350ms both; }
@keyframes luxury-sweep-entry {
  0% { transform: translateX(-125%); opacity: 0; }
  12%, 80% { opacity: 1; }
  100% { transform: translateX(125%); opacity: 0; }
}
@keyframes luxury-sweep-hover {
  0% { transform: translateX(-125%); opacity: 0; }
  12%, 80% { opacity: 1; }
  100% { transform: translateX(125%); opacity: 0; }
}

/* Existing reveal states orchestrate the heading; text and semantics stay intact. */
.luxury-heading { clip-path: inset(100% 0 0); opacity: .2; }
.luxury-heading.is-in-view {
  animation: luxury-heading 1400ms var(--luxury-ease) both;
}
.section__head.reveal.is-visible .section__lead,
.product-motion__heading--visible .section__lead {
  animation: luxury-caption 1000ms var(--luxury-ease) 140ms both;
}
@keyframes luxury-heading {
  from { clip-path: inset(100% 0 0); opacity: .2; }
  to { clip-path: inset(-.12em -.05em -.18em); opacity: 1; }
}
@keyframes luxury-caption {
  from { opacity: 0; translate: 0 10px; }
  to { opacity: 1; translate: none; }
}

@media (max-width: 639px) {
  .card--3d .card__media img { translate: 0 0; }
  .header.is-scrolled { backdrop-filter: blur(16px) saturate(125%); }
}
@media (prefers-reduced-motion: reduce) {
  .header, .header.is-scrolled { transition: none; }
  .card--3d .card__media, .card--3d.is-tilting .card__media,
  .card--3d .card__media img { transform: none; translate: none; transition: none; }
  .card--3d .card__shine, .card--3d .tilt__glare,
  .product-story__image::after, .auto-showcase__image::after { display: none; }
  .luxury-heading, .luxury-heading.is-in-view,
  .section__head.reveal.is-visible .section__lead,
  .product-motion__heading--visible .section__lead {
    animation: none; clip-path: none; translate: none; opacity: 1;
  }
}
