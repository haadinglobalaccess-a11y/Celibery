/* ================= Announcement / header ================= */
.announce {
  background: var(--ink);
  color: #fff;
  font-size: var(--fs-xs);
  text-align: center;
  padding: 6px var(--s-4);
  font-weight: 600;
}
.header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgb(255 255 255 / 0.92);
  backdrop-filter: saturate(180%) blur(14px);
  border-bottom: 1px solid var(--line);
}
.header__bar {
  height: var(--header-h);
  display: flex;
  align-items: center;
  gap: var(--s-4);
}
.header__nav {
  display: none;
  gap: var(--s-1);
  align-items: center;
  margin-inline-start: var(--s-4);
}
.header__nav > a,
.header__nav > button {
  min-height: var(--tap);
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0 var(--s-3);
  border-radius: var(--r-pill);
  font-weight: 600;
  font-size: var(--fs-sm);
  border: 0;
  background: transparent;
}
.header__nav > a:hover,
.header__nav > button:hover,
.header__nav > button[aria-expanded='true'] {
  background: var(--surface);
}
.header__actions {
  margin-inline-start: auto;
  display: flex;
  align-items: center;
  gap: 2px;
}
.lang-switch {
  min-height: 36px;
  padding: 0 var(--s-3);
  border-radius: var(--r-pill);
  border: 1.5px solid var(--line);
  font-weight: 700;
  font-size: var(--fs-sm);
  display: inline-flex;
  align-items: center;
  margin-inline-end: var(--s-1);
}
.lang-switch:hover {
  border-color: var(--ink);
}
.logo {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-en);
  font-weight: 800;
  letter-spacing: 0.22em;
  font-size: 1.15rem;
  direction: ltr;
}
.logo img {
  height: 30px;
  width: auto;
}
.logo small {
  font-size: 0.55em;
  letter-spacing: 0.3em;
  font-weight: 600;
  opacity: 0.6;
}
.header__search {
  display: none;
  flex: 1;
  max-width: 420px;
  margin-inline-start: auto;
}
.searchbox {
  position: relative;
  width: 100%;
}
.searchbox .input {
  padding-inline-start: 42px;
  background: var(--surface);
  border-color: transparent;
  border-radius: var(--r-pill);
}
.searchbox .icon {
  position: absolute;
  inset-inline-start: 14px;
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  color: var(--muted);
}
.mobile-only {
  display: inline-grid;
}
@media (min-width: 960px) {
  .header__nav {
    display: flex;
  }
  .header__search {
    display: block;
  }
  .header__actions {
    margin-inline-start: var(--s-4);
  }
  .mobile-only {
    display: none !important;
  }
}

/* Mega menu (Q5) */
.mega {
  position: absolute;
  inset-inline: 0;
  top: 100%;
  background: #fff;
  border-bottom: 1px solid var(--line);
  box-shadow: var(--shadow-md);
  animation: mega-in var(--dur) var(--ease);
}
@keyframes mega-in {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }
}
.mega__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr) 280px;
  gap: var(--s-6);
  padding-block: var(--s-8);
}
.mega__cat {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: var(--s-3);
  align-items: start;
  padding: var(--s-2);
  border-radius: var(--r-md);
}
.mega__cat:hover {
  background: var(--surface);
}
.mega__cat img {
  width: 64px;
  height: 64px;
  border-radius: var(--r-md);
  object-fit: cover;
  background: var(--surface);
}
.mega__cat strong {
  display: block;
}
.mega__cat ul {
  list-style: none;
  margin: 4px 0 0;
  padding: 0;
  font-size: var(--fs-xs);
  color: var(--muted);
}
.mega__side {
  background: var(--dark);
  color: var(--on-dark);
  border-radius: var(--r-lg);
  padding: var(--s-6);
  display: grid;
  align-content: end;
  gap: var(--s-2);
  min-height: 220px;
}
.mega__side a {
  color: #fff;
  font-weight: 600;
}

/* Mobile menu */
.mnav a,
.mnav button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 52px;
  border: 0;
  border-bottom: 1px solid var(--line);
  background: none;
  font-weight: 600;
  text-align: start;
  padding: 0 var(--s-1);
}

/* ================= Hero / dark premium sections ================= */
.dark {
  background: var(--dark);
  color: var(--on-dark);
}
.dark .muted {
  color: var(--on-dark-muted);
}
.hero {
  position: relative;
  overflow: hidden;
  min-height: min(78vh, 760px);
  display: grid;
  align-items: end;
  isolation: isolate;
}
.hero__media,
.hero__media video,
.hero__media img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: -2;
}
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(to top, rgb(0 0 0 / 0.75), rgb(0 0 0 / 0.1) 60%);
}
.hero__content {
  padding-block: var(--s-16) var(--s-12);
  max-width: 720px;
}
.hero h1 {
  font-size: var(--fs-hero);
  font-weight: 800;
  margin-bottom: var(--s-4);
}
html[lang='en'] .hero h1 {
  text-transform: uppercase;
  letter-spacing: -0.02em;
}
.hero p {
  font-size: var(--fs-lg);
  color: var(--on-dark-muted);
  max-width: 560px;
}
.hero__ctas {
  display: flex;
  gap: var(--s-3);
  flex-wrap: wrap;
  margin-top: var(--s-6);
}
.hero__dots {
  display: flex;
  gap: 8px;
  margin-top: var(--s-8);
}
.hero__dots button {
  width: 28px;
  height: 4px;
  border-radius: 4px;
  border: 0;
  padding: 0;
  background: rgb(255 255 255 / 0.3);
  transition:
    background var(--dur),
    width var(--dur);
}
.hero__dots button[aria-current='true'] {
  background: #fff;
  width: 44px;
}
.slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 900ms var(--ease);
}
.slide[data-active='true'] {
  opacity: 1;
}
.slide img {
  transform: scale(1.04);
  transition: transform 6s linear;
}
.slide[data-active='true'] img {
  transform: scale(1);
}
/* Product slider fallback (no hero video or banners yet) */
.hero-products {
  position: absolute;
  inset: 0;
  z-index: -2;
  display: grid;
  place-items: center;
  background: radial-gradient(circle at 70% 35%, #26262b 0%, var(--dark) 62%);
}
.hero-products__item {
  position: absolute;
  width: min(42vw, 360px);
  aspect-ratio: 1;
  inset-inline-end: 8%;
  top: 12%;
  border-radius: var(--r-xl);
  overflow: hidden;
  opacity: 0;
  transform: translateY(16px) scale(0.98);
  transition:
    opacity 900ms var(--ease),
    transform 900ms var(--ease);
  background: #f3f3f4;
  box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
}
.hero-products__item[data-active='true'] {
  opacity: 1;
  transform: none;
}
.hero-products__item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
@media (max-width: 639px) {
  .hero-products__item {
    width: 56vw;
    top: 8%;
    inset-inline-end: 50%;
    transform: translateX(50%);
  }
  html[dir='rtl'] .hero-products__item {
    transform: translateX(-50%);
  }
  .hero-products__item[data-active='true'] {
    transform: translateX(50%);
  }
  html[dir='rtl'] .hero-products__item[data-active='true'] {
    transform: translateX(-50%);
  }
  .hero {
    min-height: 88vh;
  }
}

/* Service strip */
.service {
  border-bottom: 1px solid var(--line);
}
.service__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s-3);
  padding-block: var(--s-4);
}
.service__item {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  font-size: var(--fs-sm);
  font-weight: 600;
}
.service__item .icon {
  width: 26px;
  height: 26px;
}
@media (min-width: 960px) {
  .service__grid {
    grid-template-columns: repeat(4, 1fr);
    padding-block: var(--s-5);
  }
}

/* ================= Sections ================= */
.section {
  padding-block: var(--s-12);
}
@media (min-width: 960px) {
  .section {
    padding-block: var(--s-16);
  }
}
.section--tight {
  padding-block: var(--s-8);
}
.section--surface {
  background: var(--surface);
}
.section__head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: var(--s-4);
  margin-bottom: var(--s-6);
}
.section__head h2 {
  font-size: var(--fs-2xl);
  margin: 0;
}
.section__head a {
  font-weight: 600;
  font-size: var(--fs-sm);
  white-space: nowrap;
}
.eyebrow {
  display: inline-block;
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: var(--s-2);
}
html[lang='ar'] .eyebrow {
  letter-spacing: 0;
}

/* Category tiles */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s-3);
}
@media (min-width: 640px) {
  .cat-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }
}
@media (min-width: 1200px) {
  .cat-grid {
    grid-template-columns: repeat(6, 1fr);
  }
}
.cat-tile {
  display: grid;
  gap: var(--s-3);
  padding: var(--s-3);
  border-radius: var(--r-lg);
  background: var(--surface);
  transition:
    transform var(--dur) var(--ease),
    box-shadow var(--dur) var(--ease);
}
.cat-tile:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}
.cat-tile img {
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: var(--r-md);
  background: #fff;
}
.cat-tile strong {
  font-size: var(--fs-sm);
  padding-inline: var(--s-1);
}

/* Product grid & card */
.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--s-3);
}
@media (min-width: 640px) {
  .grid {
    gap: var(--s-5);
  }
}
@media (min-width: 960px) {
  .grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
@media (min-width: 1200px) {
  .grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
.scroller {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(220px, 46%);
  gap: var(--s-4);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: var(--s-2);
  scrollbar-width: thin;
}
.scroller > * {
  scroll-snap-align: start;
}
@media (min-width: 960px) {
  .scroller {
    grid-auto-columns: calc((100% - 3 * var(--s-4)) / 4);
  }
}
.card {
  position: relative;
  display: flex;
  flex-direction: column;
  border-radius: var(--r-lg);
  background: #fff;
  transition:
    transform var(--dur) var(--ease),
    box-shadow var(--dur) var(--ease);
}
.card__media {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--surface);
}
.card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--dur-slow) var(--ease);
}
.card:hover .card__media img {
  transform: scale(1.04);
}
.card__badges {
  position: absolute;
  top: var(--s-2);
  inset-inline-start: var(--s-2);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
}
.card__wish {
  position: absolute;
  top: var(--s-2);
  inset-inline-end: var(--s-2);
  background: rgb(255 255 255 / 0.9);
  width: 38px;
  height: 38px;
}
.card__wish[aria-pressed='true'] {
  color: #e11d48;
}
.card__body {
  display: grid;
  gap: 4px;
  padding: var(--s-3) var(--s-1) 0;
  flex: 1;
}
.card__model {
  font-size: var(--fs-xs);
  color: var(--muted);
}
.card__title {
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card__title a::after {
  content: '';
  position: absolute;
  inset: 0;
}
.card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-2);
  padding: var(--s-2) var(--s-1) var(--s-1);
  position: relative;
  z-index: 1;
}
.card__add {
  width: 40px;
  height: 40px;
  border-radius: var(--r-pill);
  border: 0;
  background: var(--ink);
  color: #fff;
  display: grid;
  place-items: center;
  flex: none;
}
.card__add[disabled] {
  background: var(--surface-2);
  color: var(--muted-2);
  cursor: not-allowed;
}

/* Lifestyle / banners */
.banner {
  position: relative;
  border-radius: var(--r-xl);
  overflow: hidden;
  min-height: 320px;
  display: grid;
  align-items: end;
  isolation: isolate;
  color: #fff;
}
.banner img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: -2;
}
.banner::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent 65%);
}
.banner--light {
  color: var(--ink);
}
.banner--light::after {
  background: linear-gradient(to top, rgb(255 255 255 / 0.85), transparent 65%);
}
.banner__body {
  padding: var(--s-8);
  max-width: 560px;
}
.banner__body h3 {
  font-size: var(--fs-2xl);
}

/* Why / use cases / story */
.why-grid {
  display: grid;
  gap: var(--s-4);
}
@media (min-width: 640px) {
  .why-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 960px) {
  .why-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}
.why-item {
  border: 1px solid var(--dark-line);
  border-radius: var(--r-lg);
  padding: var(--s-6);
  background: var(--dark-2);
}
.why-item .icon {
  width: 30px;
  height: 30px;
  margin-bottom: var(--s-4);
  color: var(--accent);
}
.why-item h3 {
  font-size: var(--fs-lg);
}
.use-tabs {
  display: flex;
  gap: var(--s-2);
  overflow-x: auto;
  margin-bottom: var(--s-6);
}
.use-tabs button {
  min-height: 40px;
  padding: 0 var(--s-5);
  border-radius: var(--r-pill);
  border: 1.5px solid var(--line);
  background: #fff;
  font-weight: 600;
  white-space: nowrap;
}
.use-tabs button[aria-selected='true'] {
  background: var(--ink);
  color: #fff;
  border-color: var(--ink);
}
.story {
  display: grid;
  gap: var(--s-8);
  align-items: center;
}
@media (min-width: 960px) {
  .story {
    grid-template-columns: 1fr 1fr;
  }
}
.story img {
  border-radius: var(--r-xl);
  aspect-ratio: 4/3;
  object-fit: cover;
  width: 100%;
}
.story p {
  color: var(--on-dark-muted);
  font-size: var(--fs-lg);
}
.newsletter {
  display: grid;
  gap: var(--s-4);
  align-items: center;
  background: var(--surface);
  border-radius: var(--r-xl);
  padding: var(--s-8);
}
@media (min-width: 960px) {
  .newsletter {
    grid-template-columns: 1fr 1fr;
    padding: var(--s-12);
  }
}
.newsletter form {
  display: flex;
  gap: var(--s-2);
}
.newsletter .input {
  border-radius: var(--r-pill);
}

/* ================= Shop page ================= */
.page-head {
  padding-block: var(--s-8) var(--s-4);
}
.page-head h1 {
  font-size: var(--fs-3xl);
  margin: 0;
}
.crumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  font-size: var(--fs-xs);
  color: var(--muted);
  margin-bottom: var(--s-3);
}
.crumbs a:hover {
  color: var(--ink);
}
.shop {
  display: grid;
  gap: var(--s-6);
  padding-bottom: var(--s-16);
}
@media (min-width: 960px) {
  .shop {
    grid-template-columns: 260px 1fr;
    gap: var(--s-8);
  }
}
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-3);
  margin-bottom: var(--s-4);
  flex-wrap: wrap;
}
.toolbar .select {
  width: auto;
  min-width: 190px;
}
.filters {
  display: none;
}
@media (min-width: 960px) {
  .filters {
    display: block;
    position: sticky;
    top: calc(var(--header-h) + var(--s-4));
    align-self: start;
    max-height: calc(100vh - var(--header-h) - 2rem);
    overflow-y: auto;
  }
}
.filter-group {
  border-bottom: 1px solid var(--line);
  padding-block: var(--s-4);
}
.filter-group h3 {
  font-size: var(--fs-sm);
  margin-bottom: var(--s-2);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.chip {
  min-height: 34px;
  padding: 0 var(--s-3);
  border-radius: var(--r-pill);
  border: 1.5px solid var(--line);
  background: #fff;
  font-size: var(--fs-xs);
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.chip[aria-pressed='true'] {
  border-color: var(--ink);
  background: var(--ink);
  color: #fff;
}
.swatch {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 1px solid rgb(0 0 0 / 0.15);
}
.price-range {
  display: flex;
  gap: var(--s-2);
  align-items: center;
}
.price-range .input {
  min-height: 38px;
  padding-inline: var(--s-3);
}
.pager {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--s-3);
  margin-top: var(--s-10);
}

/* ================= Product page ================= */
.pdp {
  display: grid;
  gap: var(--s-8);
  padding-block: var(--s-4) var(--s-16);
}
@media (min-width: 960px) {
  .pdp {
    grid-template-columns: 1.1fr 1fr;
    gap: var(--s-12);
  }
}
.gallery__main {
  aspect-ratio: 1;
  border-radius: var(--r-xl);
  overflow: hidden;
  background: var(--surface);
}
.gallery__main img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.gallery__thumbs {
  display: flex;
  gap: var(--s-2);
  margin-top: var(--s-3);
  overflow-x: auto;
}
.gallery__thumbs button {
  width: 72px;
  height: 72px;
  border-radius: var(--r-md);
  border: 2px solid transparent;
  padding: 0;
  overflow: hidden;
  background: var(--surface);
  flex: none;
}
.gallery__thumbs button[aria-current='true'] {
  border-color: var(--ink);
}
.gallery__thumbs img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.pdp__info h1 {
  font-size: var(--fs-2xl);
  margin-bottom: var(--s-2);
}
.pdp__meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2) var(--s-4);
  font-size: var(--fs-sm);
  color: var(--muted);
  margin-bottom: var(--s-4);
}
.pdp__price {
  font-size: var(--fs-2xl);
  margin-bottom: 4px;
}
.pdp__buy {
  display: flex;
  gap: var(--s-3);
  align-items: center;
  margin-block: var(--s-6);
  flex-wrap: wrap;
}
.pdp__buy .btn--primary {
  flex: 1;
  min-width: 200px;
}
.info-list {
  display: grid;
  gap: var(--s-2);
  margin-block: var(--s-6);
}
.info-row {
  display: flex;
  gap: var(--s-3);
  align-items: flex-start;
  padding: var(--s-3) var(--s-4);
  border-radius: var(--r-md);
  background: var(--surface);
  font-size: var(--fs-sm);
}
.info-row .icon {
  width: 22px;
  height: 22px;
  margin-top: 2px;
}
.info-row strong {
  display: block;
}
details.acc {
  border-bottom: 1px solid var(--line);
}
details.acc summary {
  min-height: 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  font-weight: 700;
  list-style: none;
}
details.acc summary::-webkit-details-marker {
  display: none;
}
details.acc summary::after {
  content: '+';
  font-size: 22px;
  font-weight: 400;
}
details.acc[open] summary::after {
  content: '–';
}
details.acc > div {
  padding-bottom: var(--s-4);
}
.specs {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--fs-sm);
}
.specs th,
.specs td {
  text-align: start;
  padding: var(--s-2) 0;
  border-bottom: 1px dashed var(--line);
}
.specs th {
  color: var(--muted);
  font-weight: 500;
  width: 45%;
}
.sticky-buy {
  position: fixed;
  inset-inline: 0;
  bottom: 0;
  z-index: 40;
  background: #fff;
  border-top: 1px solid var(--line);
  padding: var(--s-3) var(--s-4) calc(var(--s-3) + env(safe-area-inset-bottom));
  display: flex;
  gap: var(--s-3);
  align-items: center;
  box-shadow: 0 -8px 24px rgb(0 0 0 / 0.06);
}
.sticky-buy .btn {
  flex: 1;
}
@media (min-width: 960px) {
  .sticky-buy {
    display: none;
  }
}
.has-sticky-buy {
  padding-bottom: 84px;
}
@media (min-width: 960px) {
  .has-sticky-buy {
    padding-bottom: 0;
  }
}

/* ================= Cart & checkout ================= */
.cart-layout {
  display: grid;
  gap: var(--s-8);
  padding-bottom: var(--s-16);
}
@media (min-width: 960px) {
  .cart-layout {
    grid-template-columns: 1fr 380px;
    align-items: start;
  }
}
.line {
  display: grid;
  grid-template-columns: 84px 1fr;
  gap: var(--s-4);
  padding-block: var(--s-4);
  border-bottom: 1px solid var(--line);
}
.line img {
  width: 84px;
  height: 84px;
  border-radius: var(--r-md);
  object-fit: cover;
  background: var(--surface);
}
.line__top {
  display: flex;
  justify-content: space-between;
  gap: var(--s-3);
}
.line__name {
  font-weight: 600;
  font-size: var(--fs-sm);
}
.line__actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--s-2);
  gap: var(--s-2);
}
.link-btn {
  border: 0;
  background: none;
  padding: 0;
  color: var(--muted);
  font-size: var(--fs-xs);
  text-decoration: underline;
}
.summary {
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: var(--s-6);
  position: sticky;
  top: calc(var(--header-h) + var(--s-4));
}
.summary h2 {
  font-size: var(--fs-lg);
}
.sum-row {
  display: flex;
  justify-content: space-between;
  gap: var(--s-3);
  padding-block: 6px;
  font-size: var(--fs-sm);
}
.sum-row--total {
  border-top: 1px solid var(--line);
  margin-top: var(--s-2);
  padding-top: var(--s-3);
  font-size: var(--fs-lg);
  font-weight: 800;
}
.code-form {
  display: flex;
  gap: var(--s-2);
  margin-block: var(--s-4);
}
.panel {
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  padding: var(--s-6);
  margin-bottom: var(--s-4);
}
.panel h2 {
  font-size: var(--fs-lg);
  display: flex;
  align-items: center;
  gap: var(--s-2);
}
.step-num {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: var(--ink);
  color: #fff;
  display: inline-grid;
  place-items: center;
  font-size: var(--fs-xs);
}
.pay-options {
  display: grid;
  gap: var(--s-2);
}
.pay-option {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  min-height: 56px;
  padding: var(--s-2) var(--s-4);
  border: 1.5px solid var(--line);
  border-radius: var(--r-md);
  cursor: pointer;
  font-weight: 600;
}
.pay-option:has(input:checked) {
  border-color: var(--ink);
  background: var(--surface);
}
.pay-option input {
  width: 18px;
  height: 18px;
  accent-color: var(--ink);
}
.pay-logos {
  margin-inline-start: auto;
  display: flex;
  gap: 4px;
}
.pay-logo {
  font-size: 10px;
  font-weight: 800;
  padding: 3px 6px;
  border-radius: 4px;
  border: 1px solid var(--line);
  background: #fff;
  letter-spacing: 0.02em;
  direction: ltr;
}
.address-cards {
  display: grid;
  gap: var(--s-2);
  margin-bottom: var(--s-4);
}

/* Order status timeline */
.timeline {
  list-style: none;
  padding: 0;
  margin: 0;
  border-inline-start: 2px solid var(--line);
}
.timeline li {
  position: relative;
  padding: 0 var(--s-5) var(--s-4);
}
.timeline li::before {
  content: '';
  position: absolute;
  inset-inline-start: -7px;
  top: 6px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--ink);
}
.status-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--s-2);
  margin-block: var(--s-6);
}
.status-steps div {
  text-align: center;
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--muted-2);
}
.status-steps div::before {
  content: '';
  display: block;
  height: 4px;
  border-radius: 4px;
  background: var(--line);
  margin-bottom: var(--s-2);
}
.status-steps div[data-done='true'] {
  color: var(--ink);
}
.status-steps div[data-done='true']::before {
  background: var(--accent);
}

/* Account */
.account {
  display: grid;
  gap: var(--s-6);
  padding-bottom: var(--s-16);
}
@media (min-width: 960px) {
  .account {
    grid-template-columns: 220px 1fr;
  }
}
.account nav {
  display: flex;
  gap: var(--s-2);
  overflow-x: auto;
}
@media (min-width: 960px) {
  .account nav {
    flex-direction: column;
  }
}
.account nav a {
  min-height: 42px;
  display: flex;
  align-items: center;
  padding: 0 var(--s-4);
  border-radius: var(--r-md);
  font-weight: 600;
  white-space: nowrap;
}
.account nav a.active,
.account nav a:hover {
  background: var(--surface);
}
.auth-box {
  max-width: 440px;
  margin: var(--s-10) auto var(--s-16);
}
.order-card {
  display: flex;
  justify-content: space-between;
  gap: var(--s-4);
  padding: var(--s-4);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  margin-bottom: var(--s-3);
  flex-wrap: wrap;
}

/* ================= Footer ================= */
.footer {
  background: var(--dark);
  color: var(--on-dark-muted);
  padding-block: var(--s-12) var(--s-6);
  font-size: var(--fs-sm);
}
.footer a:hover {
  color: #fff;
}
.footer h3 {
  color: #fff;
  font-size: var(--fs-sm);
  margin-bottom: var(--s-3);
}
.footer__grid {
  display: grid;
  gap: var(--s-8);
}
@media (min-width: 640px) {
  .footer__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 960px) {
  .footer__grid {
    grid-template-columns: 1.4fr repeat(3, 1fr);
  }
}
.footer ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: var(--s-2);
}
.footer .logo {
  color: #fff;
  margin-bottom: var(--s-3);
}
.footer__legal {
  border-top: 1px solid var(--dark-line);
  margin-top: var(--s-10);
  padding-top: var(--s-6);
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-3) var(--s-6);
  justify-content: space-between;
  font-size: var(--fs-xs);
}
.footer .pay-logo {
  background: #fff;
  color: var(--ink);
}
.footer__social {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: var(--s-5);
}

.footer__social a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  color: #e8e8e8;
  background: rgb(255 255 255 / 0.035);
  border: 1px solid rgb(255 255 255 / 0.14);
  border-radius: 50%;
  text-decoration: none;
  transition:
    color 220ms ease,
    background 220ms ease,
    border-color 220ms ease,
    transform 220ms ease,
    box-shadow 220ms ease;
}

.footer__social a:hover {
  color: #fff;
  background: rgb(255 255 255 / 0.12);
  border-color: rgb(255 255 255 / 0.4);
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.22);
}

.footer__social a:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 4px;
}

.footer__social svg {
  display: block;
  flex: 0 0 auto;
}

@media (prefers-reduced-motion: reduce) {
  .footer__social a {
    transition: none;
  }
  .footer__social a:hover {
    transform: none;
  }
}

/* WhatsApp floating button */
.wa-fab {
  position: fixed;
  bottom: calc(var(--s-5) + env(safe-area-inset-bottom));
  inset-inline-end: var(--s-5);
  z-index: 45;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #25d366;
  color: #fff;
  display: grid;
  place-items: center;
  box-shadow: var(--shadow-lg);
  transition: transform var(--dur) var(--ease);
}
.wa-fab:hover {
  transform: scale(1.06);
}
.has-sticky-buy ~ .wa-fab,
.wa-fab--raised {
  bottom: calc(96px + env(safe-area-inset-bottom));
}
@media (min-width: 960px) {
  .wa-fab--raised {
    bottom: var(--s-5);
  }
}

/* Policy pages */
.prose {
  max-width: 760px;
}
.prose h2 {
  font-size: var(--fs-xl);
  margin-top: var(--s-8);
}
.prose blockquote {
  margin: 0 0 var(--s-6);
  padding: var(--s-3) var(--s-4);
  border-inline-start: 4px solid var(--warning);
  background: var(--warning-bg);
  border-radius: var(--r-sm);
  color: var(--warning);
  font-size: var(--fs-sm);
}
.prose ul {
  padding-inline-start: var(--s-6);
}

/* Campaign accent (e.g. National Day green) */
.campaign-hero {
  border-radius: var(--r-xl);
  overflow: hidden;
  padding: var(--s-12) var(--s-8);
  background: var(--campaign-accent, var(--dark));
  color: #fff;
  margin-block: var(--s-6);
}
.sample-banner {
  background: #fff7d6;
  color: #7a5b00;
  font-size: var(--fs-xs);
  text-align: center;
  padding: 6px var(--s-4);
  border-bottom: 1px dashed #d9b84a;
}

.filters-btn {
  display: inline-flex;
}
@media (min-width: 960px) {
  .filters-btn {
    display: none;
  }
}
html[dir='rtl'] .chevron-fwd {
  transform: scaleX(-1);
}

/* CELIBERY — LinkedIn official brand color */
.footer__social a[href*="linkedin.com"] {
    color: #0A66C2 !important;
}
