# =====================================================================
# CELIBERY International — environment configuration
# Copy to `.env` (local) or add to Vercel → Project → Settings → Environment Variables.
# NEVER commit a real `.env` file. All values below are examples / placeholders.
# =====================================================================

# --- Core -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the storefront (used in emails, payment return URLs, sitemap).
PUBLIC_SITE_URL=http://localhost:5173
# Comma-separated list of allowed browser origins for the API (CORS).
CORS_ORIGINS=http://localhost:5173

# --- Database (MongoDB Atlas recommended; must be a replica set for transactions) ---
MONGODB_URI=mongodb://127.0.0.1:27017/celibery?directConnection=true
MONGODB_DB_NAME=celibery

# --- Authentication ---------------------------------------------------
# Long random string (min. 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_HOURS=168
# Set to true behind HTTPS (always true in production).
COOKIE_SECURE=false

# --- Credential encryption (REQUIRED in production to manage gateways from the admin) ---
# 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it ONLY in the hosting provider's secret settings — never in the database or Git.
# Losing it means re-entering the gateway credentials in Admin → Settings → Payments.
CREDENTIALS_ENCRYPTION_KEY=
# During key rotation only: the previous key(s), comma separated, until `npm run migrate -- --reencrypt` has run.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# --- Payments ---------------------------------------------------------
# Gateway keys are normally entered by a Super Administrator in Admin → Settings → Payments
# (encrypted at rest). The MOYASAR_* / TABBY_* variables below are the legacy fallback, used only
# until credentials are saved in the dashboard.
# Card / Apple Pay / mada / STC Pay gateway: sandbox | moyasar
# (Tap, HyperPay or PayTabs can be added as adapters in server/src/integrations/payments/)
PAYMENT_GATEWAY=sandbox
# The sandbox gateway simulates payments for development/testing. It is REFUSED in production
# unless this is explicitly set to true (e.g. a private staging deployment).
ALLOW_SANDBOX_PAYMENTS=false

# Moyasar (https://moyasar.com) — pending live credentials from the client.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# Shared secret configured in the Moyasar dashboard webhook settings.
MOYASAR_WEBHOOK_SECRET=

# Tabby (buy now, pay later) — pending live credentials from the client.
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=
# Value of the auth header Tabby sends with webhooks (configured when registering the webhook).
TABBY_WEBHOOK_SECRET=

# --- Notifications ----------------------------------------------------
# Email via SMTP — legacy fallback. Prefer Admin → Settings → Notifications & reviews → Email (SMTP);
# once saved there, these variables are ignored. Leave SMTP_HOST empty to disable (messages are recorded as "skipped").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CELIBERY International <no-reply@example.com>"

# WhatsApp Business Cloud API (Meta). Leave empty to disable order notifications by WhatsApp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name of the approved WhatsApp message template used for order updates.
WHATSAPP_ORDER_TEMPLATE=order_update
WHATSAPP_TEMPLATE_LANG_AR=ar
WHATSAPP_TEMPLATE_LANG_EN=en

# --- Media storage (uploads from the admin) ----------------------------
# local = server disk under ./uploads, served at /media (development, or a server with a persistent disk).
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces…) — required on Vercel.
# Image / video URLs work in both modes. Files are never stored in MongoDB.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=
# Production on a server with a persistent disk only:
ALLOW_LOCAL_MEDIA_STORAGE=false
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public URL the files are served from (bucket public URL or CDN), e.g. https://media.celibery.international
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100

# --- Hosting regions (Q33) — documented here, shown read-only in Admin → Settings → Hosting & data ---
APP_REGION=
DATABASE_REGION=
MEDIA_REGION=

# --- Content-Security-Policy (optional) ---------------------------------
# Extra https origins the browser may call (space or comma separated), e.g. a separate API domain.
CSP_CONNECT_SRC=
# Endpoint that receives CSP violation reports.
CSP_REPORT_URI=

# --- Scheduled jobs ---------------------------------------------------
# Secret used by Vercel Cron to call /api/cron/* endpoints (sent as Authorization: Bearer <secret>):
#   /api/cron/release-reservations (every 15 min) · /api/cron/maintenance (every 30 min: refund reconciliation, abandoned uploads)
CRON_SECRET=replace-with-another-random-secret

# --- Frontend (Vite; exposed to the browser — never put secrets here) --
# Leave empty when the API is served from the same domain (/api), as on Vercel.
VITE_API_BASE_URL=
